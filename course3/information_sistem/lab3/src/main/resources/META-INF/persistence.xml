<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="bookPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>


        <class>com.example.lab1.entities.Coordinates</class>
        <class>com.example.lab1.entities.MagicCity</class>
        <class>com.example.lab1.entities.Ring</class>
        <class>com.example.lab1.entities.BookCreature</class>
        <class>com.example.lab1.entities.ImportHistory</class>

        <properties>
            <property name="eclipselink.weaving" value="false"/>

            <!-- JDBC Connection Configuration (используется как fallback) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/studs"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>
            
            <!-- Использование Druid DataSource через SessionCustomizer -->
            <property name="eclipselink.session.customizer" value="com.example.lab1.config.DruidSessionCustomizer"/>
            
            <!-- Примечание: Druid Connection Pool настраивается через DruidDataSourceProvider -->
            <!-- Параметры конфигурации Druid:
                 - initialSize: 5 (начальный размер пула)
                 - minIdle: 5 (минимальное количество простаивающих соединений)
                 - maxActive: 20 (максимальное количество активных соединений)
                 - maxWait: 60000 (максимальное время ожидания соединения в мс)
                 - timeBetweenEvictionRunsMillis: 60000 (интервал проверки простаивающих соединений)
                 - minEvictableIdleTimeMillis: 300000 (минимальное время простоя перед удалением)
                 - validationQuery: SELECT 1 (SQL запрос для проверки соединения)
                 - testWhileIdle: true (проверка соединений во время простоя)
                 - poolPreparedStatements: true (кэширование PreparedStatement)
                 - maxPoolPreparedStatementPerConnectionSize: 20 (максимум PreparedStatement на соединение)
                 - filters: stat,wall (статистика и защита от SQL инъекций)
            -->

            <!-- Создание схемы при старте -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>

            <!-- SQL вывод -->
            <property name="eclipselink.logging.level" value="FINE"/>
            
            <!-- Настройки изоляции транзакций -->
            <!-- Timeout для блокировок (в миллисекундах) -->
            <property name="jakarta.persistence.lock.timeout" value="5000"/>
            
            <!-- L2 JPA Cache Configuration -->
            <!-- Включение общего кэша второго уровня -->
            <property name="eclipselink.cache.shared.default" value="true"/>
            <!-- Тип кэша: FULL - кэшируются все объекты, WEAK - слабые ссылки, SOFT - мягкие ссылки -->
            <property name="eclipselink.cache.type.default" value="FULL"/>
            <!-- Размер кэша по умолчанию -->
            <property name="eclipselink.cache.size.default" value="1000"/>
            <!-- Время жизни объектов в кэше (в миллисекундах) -->
            <property name="eclipselink.cache.expiry" value="3600000"/>
    
        </properties>
    </persistence-unit>

</persistence>
